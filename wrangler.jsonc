// Bevry Billing Worker: the static assets in public/ plus the app router in worker/.
// Secrets never live here: set them with `wrangler secret put` and .dev.vars locally.
// See .dev.vars.example for the variable names.
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "billing",
	"main": "worker/index.ts",
	"compatibility_date": "2026-11-02",
	"assets": {
		"directory": "./public",
		"binding": "ASSETS"
	},
	// daet 4 imports start-of-week, whose browser export reads window.
	// Workers has no window, so use the plain node export instead.
	"alias": {
		"start-of-week": "./node_modules/start-of-week/edition-es2022-esm/index.js"
	},
	// The custom domain provisions DNS and the certificate.
	// Release the Pages custom domain before the first deploy, or the two projects conflict.
	"routes": [
		{ "pattern": "billing.bevry.me", "custom_domain": true },
		{ "pattern": "billing.bevry.me/*", "zone_name": "bevry.me" }
	],
	"workers_dev": true,
	// Approximate per-location limits. Use a Durable Object for strict global limits.
	"ratelimits": [
		{
			"name": "LOGIN_IP_RATE_LIMITER",
			"namespace_id": "1001",
			"simple": { "limit": 10, "period": 60 }
		},
		{
			"name": "LOGIN_EMAIL_RATE_LIMITER",
			"namespace_id": "1002",
			"simple": { "limit": 3, "period": 60 }
		},
		{
			"name": "VERIFY_IP_RATE_LIMITER",
			"namespace_id": "1003",
			"simple": { "limit": 10, "period": 60 }
		}
	],
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1
	}
}
