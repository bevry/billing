{
  "title": "Bevry Billing",
  "name": "bevry-billing",
  "private": true,
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "build": "npx @tailwindcss/cli -i ./public/tailwind.css -o ./public/tailwind.min.css --minify",
    "prestart": "npm run build",
    "start": "wrangler dev",
    "predeploy": "npm run build",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit --skipLibCheck"
  },
  "dependencies": {
    "daet": "^4.7.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "simplytyped": "^3.3.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261102.1",
    "@tailwindcss/cli": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-bevry": "^6.1.6",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "wrangler": "^4.156.1"
  },
  "prettier": {
    "semi": false,
    "singleQuote": true,
    "trailingComma": "es5"
  }
}
